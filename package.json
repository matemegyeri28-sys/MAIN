{
  "name": "main",
  "private": true,
  "version": "1.0.0",
  "description": "SaaS marketing automation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run --workspaces --if-present dev",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "format": "npm run format --workspaces",
    "seed": "npm run seed --workspace @main/server"
  },
  "devDependencies": {
    "@prisma/client": "^5.13.0",
    "@types/node": "^20.11.30",
    "prisma": "^5.13.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
