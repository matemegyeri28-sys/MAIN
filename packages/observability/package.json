{
  "name": "@main/observability",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "./src/index.ts",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --out-dir dist",
    "dev": "tsup src/index.ts --watch --format esm --out-dir dist",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest",
    "format": "prettier --write 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.4.5"
  }
}
