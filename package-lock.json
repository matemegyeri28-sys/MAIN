{
  "name": "main",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "main",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {},
      "engines": {
        "node": ">=18.18.0"
      }
    },
    "apps/server": {
      "name": "@main/server",
      "version": "1.0.0",
      "dependencies": {
        "@main/shared": "file:../../packages/shared"
      }
    },
    "apps/web": {
      "name": "@main/web",
      "version": "1.0.0",
      "dependencies": {
        "@main/shared": "file:../../packages/shared"
      }
    },
    "node_modules/@main/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@main/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@main/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@main/shared",
      "version": "1.0.0"
    }
  }
}
