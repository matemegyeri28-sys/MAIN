{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@main/shared": ["packages/shared/src/index.ts"],
      "@main/shared/*": ["packages/shared/src/*"],
      "@main/config": ["packages/config/src/index.ts"],
      "@main/observability": ["packages/observability/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/node_modules/*"]
}
